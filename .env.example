NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL=./data/automation.sqlite
MEDIA_STORAGE_DIR=./data/media

WHATSAPP_ADAPTER_MODE=mock
WHATSAPP_AUTH_DIR=./private/whatsapp-auth
WHATSAPP_SOURCE_GROUP_JID=0000000000-0000000000@g.us
WHATSAPP_MALAY_GROUP_JID=0000000000-0000000001@g.us
WHATSAPP_ENGLISH_GROUP_JID=0000000000-0000000002@g.us
WHATSAPP_MANDARIN_GROUP_JID=0000000000-0000000003@g.us
WHATSAPP_TAMIL_GROUP_JID=0000000000-0000000004@g.us

AI_PROVIDER=mock
AI_MODEL=gemini-3.8-flash
AI_API_KEY=replace-with-a-secret

ANNOUNCEMENT_SCORE_THRESHOLD=4.0
CONTEXT_MAX_MESSAGES=5
CONTEXT_WINDOW_SECONDS=300
MAX_CONCURRENT_INGESTIONS=1
MAX_MEDIA_BYTES=10485760
DELIVERY_POLL_INTERVAL_MS=1000
DELIVERY_PACING_MS=1500
DELIVERY_SEND_TIMEOUT_MS=30000
DATA_RETENTION_DAYS=14
BROADCAST_KILL_SWITCH=false
